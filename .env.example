# Copy to .env and export these values into the shell before running the loader.
# The loader reads process environment variables only; it does not parse .env.
SNOWFLAKE_ACCOUNT=replace_with_account_identifier
SNOWFLAKE_USER=replace_with_username
SNOWFLAKE_PASSWORD=replace_with_password
# For SSO instead of password, leave SNOWFLAKE_PASSWORD unset and set:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=replace_with_warehouse
SNOWFLAKE_DATABASE=replace_with_database
SNOWFLAKE_SCHEMA=replace_with_schema
SNOWFLAKE_RAW_TABLE=replace_with_raw_table
# Optional:
# SNOWFLAKE_ROLE=replace_with_role
